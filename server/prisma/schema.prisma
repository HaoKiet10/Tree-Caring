// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId       Int              @id @default(autoincrement())
  email        String           @unique
  passwordHash String
  fullName     String?
  deviceId     Int?             @unique
  
  // Quan hệ
  sensorLogs      SensorLog[]
  wateringControl WateringControl?
  
  @@map("users")
}

model SensorLog {
  logId          BigInt   @id @default(autoincrement())
  temperature    Decimal?
  humidity       Decimal?
  soilMoisture   Decimal?
  lightIntensity Decimal?
  recordedAt     DateTime @default(now())
  deviceId       Int?
  
  // Quan hệ: logId tham chiếu tới deviceId của User
  user           User?    @relation(fields: [deviceId], references: [deviceId])

  @@map("sensorLogs")
}

model WateringControl {
  controlId     BigInt   @id @default(autoincrement())
  userId        Int      @unique
  pumpStatus    Boolean? @default(false)
  mode          String?  @default("MANUAL")
  soilThreshold Int?     @default(30)
  updatedAt     DateTime @default(now()) @updatedAt

  // Quan hệ: 1-1 với User
  user          User     @relation(fields: [userId], references: [userId])

  @@map("wateringControl")
}

model Song {
  songId Int     @id @default(autoincrement())
  title  String
  artist String?

  @@map("songs")
}