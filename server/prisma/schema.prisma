generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Bảng User
model User {
  userId       Int     @id @default(autoincrement())
  deviceId     Int?    @unique
  email        String  @unique
  passwordHash String
  fullName     String?

  // Quan hệ ngược (Reverse relations)
  sensorLog SensorLog[] // Một user có thể có nhiều sensorLogs qua Device
  wateringControl WateringControl? // Quan hệ 1-1 (Một user chỉ có 1 bảng điều khiển)

  @@map("users") // Mapping với tên bảng trong SQL
}


model SensorLog {
  logId          BigInt   @id @default(autoincrement())
  temperature    Decimal? @db.Decimal // SQL numeric map sang Decimal
  humidity       Decimal? @db.Decimal
  soilMoisture   Decimal? @db.Decimal
  lightIntensity Decimal? @db.Decimal
  recordedAt     DateTime @default(now())

  // Khóa ngoại (Foreign Key)
  deviceId Int

  user User @relation(fields: [deviceId], references: [deviceId])

  @@map("sensorLogs")
}

// 3. Bảng WateringControl (Điều khiển tưới)
model WateringControl {
  controlId       BigInt    @id @default(autoincrement())
  userId          Int       @unique // Unique để đảm bảo quan hệ 1-1
  pumpStatus      Boolean   @default(false)
  mode            String    @default("MANUAL") // Có thể đổi thành Enum nếu muốn chặt chẽ hơn
  soilThreshold   Int       @default(30)
  maxPumpDuration Int       @default(10)
  lastWateredAt   DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt // Tự động cập nhật thời gian khi sửa đổi

  user User @relation(fields: [userId], references: [userId])

  @@map("wateringControl")
}

// 4. Bảng Songs (Bài hát - giữ nguyên theo SQL của bạn)
model Song {
  songId Int     @id @default(autoincrement())
  title  String
  artist String?

  @@map("songs")
}